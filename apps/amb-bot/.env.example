# AMB bot (Vercel) — set these as Environment Variables in the Vercel project.
# Slack app → Basic Information → App Credentials → "Signing Secret"
SLACK_SIGNING_SECRET=
# Slack app → OAuth & Permissions → Bot User OAuth Token (xoxb-…)
SLACK_BOT_TOKEN=
# AMB Supabase (project mdviqkylamtwjubnybrp) — service role (bypasses RLS)
NEXT_PUBLIC_SUPABASE_URL=https://mdviqkylamtwjubnybrp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic (brand-doc + storyboard synthesis)
ANTHROPIC_API_KEY=
# Any random string; Vercel sends it to the cron route as `Authorization: Bearer`
CRON_SECRET=
